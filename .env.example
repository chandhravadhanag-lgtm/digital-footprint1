# Digital Footprint Analyzer Environment Configuration

# Optional: Brave Search API Key for real-time web discovery.
# If omitted, the application automatically uses resilient web search fallbacks.
# Obtain a free key at: https://brave.com/search/api/
BRAVE_API_KEY=

# Database Connection (Default: SQLite for zero setup, or PostgreSQL)
DATABASE_URL=sqlite:///./digitaltrace.db

# Server Port
PORT=8000
HOST=0.0.0.0
